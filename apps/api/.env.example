# Spring profile (dev | portfolio | prod | docker | h2 | test)
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:mysql://localhost:3306/darlemlih?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=<your_db_user>
DB_PASSWORD=<your_db_password>

# Portfolio profile only: persistent H2 database file path for a demo deployment.
# On Render this matches render.yaml's disk mount.
PORTFOLIO_DB_PATH=/var/data/darlemlih

# JWT — values are MILLISECONDS.
# Min 32 chars for the secret (validated at startup). Generate with:
#   openssl rand -hex 32
JWT_SECRET=<your_jwt_secret_min_32_chars>
JWT_ACCESS_TOKEN_EXPIRATION=900000      # 15 minutes
JWT_REFRESH_TOKEN_EXPIRATION=604800000  # 7 days

# Payment provider — 'mock' (dev only) or 'stripe' (required in prod).
# The 'portfolio' profile uses mock checkout for a public demo.
# The 'prod' profile FORCES this to 'stripe' and PaymentConfig fails fast on 'mock'.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# success/cancel URLs are validated against APP_BASE_URL + WEB_BASE_URL.
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

# SMTP (Mailhog locally on :1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@darlemlih.ma
MAIL_FROM_NAME=Dar Lemlih Apiculture
APP_EMAIL_FROM=
APP_EMAIL_ADMIN=admin@darlemlih.ma

# Application URLs
APP_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Uploads
UPLOAD_PATH=./uploads
UPLOAD_PUBLIC_BASE_URL=/uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_MAX_FILES=6

# AWS / LocalStack (only used when STORAGE_S3_ENABLED=true)
STORAGE_S3_ENABLED=false
S3_BUCKET=media
AWS_ENDPOINT_URL=http://localhost:4566
AWS_PUBLIC_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Server
SERVER_PORT=8080

# Dev-only: password used by DataInitializer (@Profile("dev")) for seed users.
SEED_DEFAULT_PASSWORD=ChangeMe!2025
