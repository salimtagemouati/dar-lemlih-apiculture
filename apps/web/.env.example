# Public — bundled into the client build, do NOT put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Production/Vercel example:
# NEXT_PUBLIC_API_URL=https://your-api-service.onrender.com

# Optional: override the default locale base URL used by Playwright tests.
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Disable Contentlayer during builds (e.g. CI without MDX content). Optional.
# DISABLE_CONTENTLAYER=true
